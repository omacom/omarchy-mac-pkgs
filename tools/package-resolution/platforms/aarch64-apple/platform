# Sourced by check. Lists are relative to the repository root.
lists=(install/omarchy-base.packages install/omarchy-aarch64.packages install/omarchy-aarch64-apple.packages)
# The image's kernel, boot chain and Apple platform packages.
# Aurora's Mesa is named as the image builder names it: as omarchy-mac's
# dependency alone it comes after stock mesa was picked, and conflicts with it.
packages=(omarchy omarchy-settings omarchy-mac-boot linux-aurora linux-aurora-headers m1n1-aurora uboot-aurora
  limine limine-mkinitcpio-hook limine-snapper-sync asahi-alarm-keyring
  mesa-aurora vulkan-aurora
  aurora-fwextract aurora-scripts alsa-ucm-conf-aurora lzfse)
forbidden_repos=(omarchy-aarch64)
transitions=(omarchy omarchy-settings omarchy-mac omarchy-mac-boot linux-aurora m1n1-aurora uboot-asahi
  hyprland aquamarine limine-mkinitcpio-hook)
kernel=linux-aurora
