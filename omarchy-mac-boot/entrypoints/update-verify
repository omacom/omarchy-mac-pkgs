#!/bin/bash

# omarchy-lifecycle-dispatch update-verify. omarchy update runs this after its
# package transaction, migrations and hooks, and neither finishes nor offers a
# reboot until it passes. The boot check, limited to the boot chain, proves the
# next boot reads what they installed: the kernel, initramfs and unlock
# settings, m1n1 stage 2 with that kernel's device trees and U-Boot on the
# system ESP, and on a Limine Mac the loader, menu and UKI on that same ESP.
# The installed kernel may be newer than the running one until that reboot.
# Nothing here rebuilds a boot file, except after a snapshot restore across a
# boot update, which keeps the ESP that booted it and leaves a marker on the boot
# partition: its boot files can stay newer than every installed package, so no
# package transaction would ever rebuild them. The rebuild runs until it finishes.
#
# /etc/omarchy-mac-boot/owner-boot-chain leaves verification to the owner.
# The packaged check still reports a failure for Macs with a leftover marker.

set -uo pipefail

owner_boot_chain=${OMARCHY_BOOT_CHECK_ROOT:-}/etc/omarchy-mac-boot/owner-boot-chain
rollback_marker=${OMARCHY_BOOT_CHECK_ROOT:-}/boot/.omarchy-mac-rolled-back

if [[ -f $owner_boot_chain ]]; then
  sudo rm -f "$rollback_marker"
  echo "Skipping boot verification: /etc/omarchy-mac-boot/owner-boot-chain is present; the owner manages this boot chain."
  if ! check_errors=$(OMARCHY_BOOT_CHECK_ALLOW_PENDING_REBOOT=1 omarchy-apple-silicon-boot-check --boot-chain 2>&1 >/dev/null); then
    reason=$(awk '
      /^Apple Silicon boot check: (warning: |objcopy \(binutils\) is not installed; )/ { next }
      sub(/^Apple Silicon boot check: /, "") { print; exit }
    ' <<<"$check_errors")
    reason=${reason:-${check_errors%%$'\n'*}}
    printf 'The packaged check would fail: %s. Remove the file to have updates verify again.\n' "${reason:-no reason reported}"
  fi
  exit 0
fi

echo -e "\e[32m\nVerify the Apple Silicon boot files\e[0m"
# The marker stays until the check below passes and every rebuild finished, so
# a rebuild that does not converge is tried again by the next update. The check
# cannot see boot-ctxr.bin, so while the marker is there that rebuild runs even
# when the check passes. A Mac whose owner manages its boot chain never rebuilds
# here, so the marker means nothing there.
# OMARCHY_MAC_BOOT_CTXR is a test seam; it expands in this shell and runs under sudo.
boot_ctxr=${OMARCHY_MAC_BOOT_CTXR:-/usr/share/libalpm/scripts/omarchy-mac-boot-ctxr}
repair_failed=""
if sudo test -f "$rollback_marker"; then
  if ! OMARCHY_BOOT_CHECK_ALLOW_PENDING_REBOOT=1 omarchy-apple-silicon-boot-check --boot-chain >/dev/null 2>&1; then
    echo "A snapshot restore left newer boot files on this Mac; rebuilding them from the installed packages"
    sudo mkinitcpio -P && sudo update-m1n1 && sudo omarchy-mac-boot-update && sudo "$boot_ctxr" ||
      { repair_failed=1; echo "The rebuild after the snapshot restore did not finish" >&2; }
  elif ! sudo "$boot_ctxr"; then
    repair_failed=1
    echo "Rebuilding boot-ctxr.bin after the snapshot restore did not finish" >&2
  fi
fi
if ! OMARCHY_BOOT_CHECK_ALLOW_PENDING_REBOOT=1 omarchy-apple-silicon-boot-check --boot-chain; then
  cat >&2 <<'MESSAGE'

This Mac might not boot what the update installed, so do not reboot yet.
Fix what the boot check reported above. To rebuild the initramfs, m1n1 and the boot menu:
  sudo mkinitcpio -P && sudo update-m1n1 && sudo omarchy-mac-boot-update && sudo /usr/share/libalpm/scripts/omarchy-mac-boot-ctxr
Then run omarchy update again: it checks the boot files before it offers the reboot.
MESSAGE
  exit 1
elif [[ -n $repair_failed ]]; then
  # The check cannot see boot-ctxr.bin, so a failed rebuild keeps the marker.
  echo "The boot files were not all rebuilt, so do not reboot yet. Fix what was reported above; the next omarchy update rebuilds them again." >&2
  exit 1
else
  sudo rm -f "$rollback_marker"
fi
