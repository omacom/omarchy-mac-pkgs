#!/bin/bash

# omarchy-lifecycle-dispatch update-verify. omarchy update runs this after its
# package transaction, migrations and hooks, and neither finishes nor offers a
# reboot until it passes. The boot check, limited to the boot chain, proves the
# next boot reads what they installed: the kernel, initramfs and unlock
# settings, m1n1 stage 2 with that kernel's device trees and U-Boot on the
# system ESP, and on a Limine Mac the loader, menu and UKI on that same ESP.
# The installed kernel may be newer than the running one until that reboot.
# Nothing here rebuilds a boot file, except after a snapshot restore across a
# boot update, which keeps the ESP that booted it and leaves a marker on the boot
# partition: its boot files can stay newer than every installed package, so no
# package transaction would ever rebuild them. The rebuild runs until it finishes.
#
# /etc/omarchy-mac-boot/owner-boot-chain leaves verification to the owner.
# The packaged check still reports a failure for Macs with a leftover marker.

set -uo pipefail

owner_boot_chain=${OMARCHY_BOOT_CHECK_ROOT:-}/etc/omarchy-mac-boot/owner-boot-chain
rollback_marker=${OMARCHY_BOOT_CHECK_ROOT:-}/boot/.omarchy-mac-rolled-back

owner_manifest=$owner_boot_chain.sha256

# The owner approves known-good files. This verifier reads the manifest as
# data and checks the named default entry, even when another kernel is listed first.
verify_owner_chain() {
  local root=${OMARCHY_BOOT_CHECK_ROOT:-/} manifest mode owner line file esp="" kernel
  local manifest_directory=${owner_manifest%/*} expected_owner=0
  local record='^[a-f0-9]{64}  ([A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+)+)$'
  local tree="" uki_file uki_hash menu_hash
  local -A files=()

  # The updater dispatches this entrypoint through sudo. The fixture root
  # lets the package tests run as their own unprivileged user.
  if [[ -n ${OMARCHY_BOOT_CHECK_ROOT:-} ]]; then
    expected_owner=$EUID
  elif (( EUID != 0 )); then
    echo "Owner boot verification requires the privileged Omarchy update dispatcher." >&2
    return 1
  fi

  [[ -f $owner_manifest && ! -L $owner_manifest && ! -L $manifest_directory ]] &&
    read -r owner mode < <(stat -c '%u %a' -- "$manifest_directory") &&
    [[ $owner == "$expected_owner" ]] && (( (8#$mode & 8#022) == 0 )) &&
    read -r owner mode < <(stat -c '%u %a' -- "$owner_manifest") &&
    [[ $owner == "$expected_owner" ]] && (( (8#$mode & 8#022) == 0 )) || {
    echo "The owner boot manifest and its directory must be owned by UID $expected_owner and writable only by that user." >&2
    return 1
  }
  manifest=$(cat -- "$owner_manifest") || return 1
  while IFS= read -r line; do
    [[ $line =~ $record ]] || { echo "Invalid owner boot manifest record." >&2; return 1; }
    file=${BASH_REMATCH[1]}
    [[ /$file/ != */../* && /$file/ != */./* && -z ${files[$file]+yes} && -f $root/$file ]] ||
      { echo "Missing, duplicate or invalid owner boot file: $file" >&2; return 1; }
    files[$file]=1
  done <<< "$manifest"

  for file in boot/efi boot; do
    if [[ -n ${files[$file/limine.conf]+yes} ]]; then
      [[ -z $esp ]] || { echo "The owner boot manifest names two Limine menus." >&2; return 1; }
      esp=$file
    fi
  done
  [[ -n $esp && -n ${files[$esp/EFI/BOOT/BOOTAA64.EFI]+yes} && -n ${files[$esp/m1n1/boot-ctxr.bin]+yes} ]] ||
    { echo "The owner boot manifest must cover the Limine menu and loader and Aura Stage 2." >&2; return 1; }

  for file in "${!files[@]}"; do
    [[ $file == *.dtb ]] && tree=$file
  done
  [[ -n $tree ]] || { echo "The owner boot manifest must cover the pinned device tree." >&2; return 1; }

  kernel=$(awk '
    /^[[:space:]]*default_entry[[:space:]]*:/ {
      count++
      sub(/^[[:space:]]*default_entry[[:space:]]*:[[:space:]]*/, "")
      sub(/[[:space:]]+$/, "")
      if (/^Omarchy\/[A-Za-z0-9_.+-]+$/) print substr($0, 9)
    }
    END { if (count != 1) exit 1 }
  ' "$root/$esp/limine.conf") &&
    [[ -n $kernel && -n ${files[$esp/EFI/Linux/omarchy_$kernel.efi]+yes} ]] ||
    { echo "The owner boot manifest must cover the named Omarchy default entry's UKI." >&2; return 1; }

  uki_file="EFI/Linux/omarchy_$kernel.efi"
  menu_hash=$(awk -v child="//$kernel" -v path="boot():/$uki_file#" '
    {
      sub(/^[[:space:]]+/, "")
      sub(/[[:space:]]+$/, "")
      if ($0 ~ /^\/[^/]/) parent = ($0 == "/+Omarchy" || $0 == "/Omarchy")
      if ($0 ~ /^\/\//) {
        entry = (parent && $0 == child)
        if (entry) entries++
      }
      if ($0 ~ /^\/[^/]/) entry = 0
      if (entry && $0 ~ /^path[[:space:]]*:/) {
        paths++
        sub(/^path[[:space:]]*:[[:space:]]*/, "")
        if (index($0, path) == 1) print substr($0, length(path) + 1)
      }
    }
    END { if (entries != 1 || paths != 1) exit 1 }
  ' "$root/$esp/limine.conf") &&
    [[ $menu_hash =~ ^[0-9a-f]{128}$ ]] &&
    uki_hash=$(b2sum -- "$root/$esp/$uki_file") && [[ ${uki_hash%% *} == "$menu_hash" ]] ||
    { echo "The named Limine default entry does not point to the recorded UKI with its correct hash." >&2; return 1; }

  if [[ -z ${OMARCHY_BOOT_CHECK_ROOT:-} ]] && ! findmnt -rn -M "/$esp" >/dev/null; then
    echo "The ESP named by the owner boot manifest is not mounted." >&2
    return 1
  fi

  if [[ -s $root/$esp/aura-try ]]; then
    echo "An Aura one-boot trial is pending on the owner-managed chain." >&2
    return 1
  fi
  (cd -- "$root" && sha256sum --check --strict --quiet <<< "$manifest") >&2 || return 1
  echo "Owner-managed boot files verified against the approved manifest."
}

if [[ -f $owner_boot_chain ]]; then
  if [[ -e $owner_manifest || -L $owner_manifest ]]; then
    if verify_owner_chain; then
      sudo rm -f "$rollback_marker"
      exit $?
    else
      echo "Owner-managed boot verification failed. Resolve the mismatch before continuing and do not reboot yet." >&2
      exit 1
    fi
  fi
  sudo rm -f "$rollback_marker"
  echo "Skipping boot verification: /etc/omarchy-mac-boot/owner-boot-chain is present; the owner manages this boot chain."
  if ! check_errors=$(OMARCHY_BOOT_CHECK_ALLOW_PENDING_REBOOT=1 omarchy-apple-silicon-boot-check --boot-chain 2>&1 >/dev/null); then
    reason=$(awk '
      /^Apple Silicon boot check: (warning: |objcopy \(binutils\) is not installed; )/ { next }
      sub(/^Apple Silicon boot check: /, "") { print; exit }
    ' <<<"$check_errors")
    reason=${reason:-${check_errors%%$'\n'*}}
    printf 'The packaged check would fail: %s. Remove the file to have updates verify again.\n' "${reason:-no reason reported}"
  fi
  exit 0
fi

echo -e "\e[32m\nVerify the Apple Silicon boot files\e[0m"
# The marker stays until the check passes and every rebuild finished. The check
# can't see boot-ctxr.bin, so that rebuild runs while the marker is there.
# OMARCHY_MAC_BOOT_CTXR is a test seam; it expands in this shell and runs under sudo.
boot_ctxr=${OMARCHY_MAC_BOOT_CTXR:-/usr/share/libalpm/scripts/omarchy-mac-boot-ctxr}
repair_failed="" ctxr_failed="" ctxr_unchecked=""
if sudo test -f "$rollback_marker"; then
  ctxr_status=0
  if ! OMARCHY_BOOT_CHECK_ALLOW_PENDING_REBOOT=1 omarchy-apple-silicon-boot-check --boot-chain >/dev/null 2>&1; then
    echo "A snapshot restore left newer boot files on this Mac; rebuilding them from the installed packages"
    if sudo mkinitcpio -P && sudo update-m1n1 && sudo omarchy-mac-boot-update; then
      sudo "$boot_ctxr" --verify
      ctxr_status=$?
    else
      repair_failed="sudo mkinitcpio -P && sudo update-m1n1 && sudo omarchy-mac-boot-update && sudo /usr/share/libalpm/scripts/omarchy-mac-boot-ctxr"
      echo "The rebuild after the snapshot restore did not finish" >&2
    fi
  else
    sudo "$boot_ctxr" --verify
    ctxr_status=$?
  fi
  case $ctxr_status in
    0) ;;
    3) ctxr_unchecked=1 ;;
    *)
      repair_failed="sudo /usr/share/libalpm/scripts/omarchy-mac-boot-ctxr" ctxr_failed=1
      echo "Rebuilding boot-ctxr.bin after the snapshot restore did not finish" >&2
      ;;
  esac
fi
if ! OMARCHY_BOOT_CHECK_ALLOW_PENDING_REBOOT=1 omarchy-apple-silicon-boot-check --boot-chain; then
  cat >&2 <<'MESSAGE'

This Mac might not boot what the update installed, so do not reboot yet.
Fix what the boot check reported above. To rebuild the initramfs, m1n1 and the boot menu:
  sudo mkinitcpio -P && sudo update-m1n1 && sudo omarchy-mac-boot-update && sudo /usr/share/libalpm/scripts/omarchy-mac-boot-ctxr
Then run omarchy update again: it checks the boot files before it offers the reboot.
MESSAGE
  exit 1
elif [[ -n $repair_failed ]]; then
  # The check cannot see boot-ctxr.bin, so a failed rebuild keeps the marker.
  cat >&2 <<MESSAGE

The boot files were not all rebuilt, so do not reboot yet.
Fix what was reported above, then rebuild them:
  $repair_failed
Then run omarchy update again.
MESSAGE
  # A TARGET in /etc/default/update-m1n1 fails it on every update until it is removed.
  [[ -z $ctxr_failed ]] || cat >&2 <<'MESSAGE'
A TARGET in /etc/default/update-m1n1 stops boot-ctxr.bin from being rebuilt: remove it,
or create /etc/omarchy-mac-boot/owner-boot-chain to manage this boot chain yourself.
MESSAGE
  exit 1
elif [[ -n $ctxr_unchecked ]]; then
  echo "The system ESP is not mounted at /boot/efi or /boot, so the boot-ctxr.bin of an M4 or later was not checked; mount it and run omarchy update again" >&2
else
  sudo rm -f "$rollback_marker"
fi
