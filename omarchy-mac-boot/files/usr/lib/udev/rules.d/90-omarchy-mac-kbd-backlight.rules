# leds_pwm registers the keyboard backlight off. Turn it on at half so the disk
# passphrase can be typed in the dark; systemd-backlight restores the saved level
# once the root is unlocked, and a backlight already on is left alone. Boards
# with a label call it kbd_backlight; the M3 Pro and Max name it from its
# colour and function instead, white:kbd_backlight.
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="*kbd_backlight", DRIVERS=="leds_pwm", ATTR{brightness}=="0", ATTR{brightness}="128"
