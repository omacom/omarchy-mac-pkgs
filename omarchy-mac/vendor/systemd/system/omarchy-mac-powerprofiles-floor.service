[Unit]
Description=Omarchy CPU frequency floor for the power profile on Apple Silicon
After=power-profiles-daemon.service systemd-logind.service
ConditionPathExists=/usr/bin/omarchy-powerprofiles-floor

[Service]
ExecCondition=/usr/bin/omarchy-hw-apple-silicon
# Balanced floors at the efficiency cores' capacity (about 460 on M1, 520 on M2):
# a floor above it would steer every task to the performance cores
Environment=OMARCHY_POWERPROFILES_FLOOR_BALANCED=smallest-core
ExecStart=/usr/bin/omarchy-powerprofiles-floor monitor
ExecStopPost=/usr/bin/omarchy-powerprofiles-floor release
Restart=on-failure
RestartSec=2
# Setting another process's utilisation clamp needs CAP_SYS_NICE, and only that
CapabilityBoundingSet=CAP_SYS_NICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
# power-profiles-daemon orders itself after multi-user.target, so wanting this
# there made a cycle that systemd broke by dropping this start job every boot
WantedBy=graphical.target
