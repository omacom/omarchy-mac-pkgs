# Omarchy's fingerprint setup writes polkit's stack after enrolling, and its
# migrations rewrite both, so the re-arm line follows each change.
[Unit]
Description=Watch the PAM stacks that carry Touch ID's re-arm

[Path]
PathChanged=/etc/pam.d/sudo
PathChanged=/etc/pam.d/polkit-1
Unit=omarchy-mac-touchid-pam.service

[Install]
WantedBy=multi-user.target
