# Takes Touch ID's re-arm out of the PAM stacks before the package that keeps
# it, or the module it names, is removed.
[Trigger]
Type = Path
Operation = Remove
Target = usr/lib/omarchy-mac/touchid-pam
Target = usr/lib/security/pam_aurora_touchid.so

[Action]
Description = Removing Touch ID's PAM lines...
When = PreTransaction
Exec = /usr/bin/sh -c '/usr/lib/omarchy-mac/touchid-pam --remove || true'
