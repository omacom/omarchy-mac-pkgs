[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/udev/rules.d/95-omarchy-mac-bluetooth-wake.rules
Target = usr/lib/omarchy-mac/bluetooth-wake-sync

[Action]
Description = Syncing Bluetooth wake with the charger...
When = PostTransaction
Exec = /usr/lib/omarchy-mac/bluetooth-wake-sync
