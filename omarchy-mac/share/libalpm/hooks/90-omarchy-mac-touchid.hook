# Activate Touch ID when an install or update brings its rule: /dev/sep-bio
# already exists then, so the add event that starts the unit has passed, and
# the post-update fingerprint check would not see "ready" until a reboot.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/udev/rules.d/94-omarchy-mac-touchid.rules

[Action]
Description = Activating Touch ID...
When = PostTransaction
Exec = /usr/bin/systemctl --quiet start omarchy-mac-touchid-activate.service
