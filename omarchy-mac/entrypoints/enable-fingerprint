#!/bin/bash
# omarchy-lifecycle-dispatch enable-fingerprint: Omarchy's fingerprint setup runs
# this as root before enrolling. It asks the owner before Touch ID is turned on,
# since that leaves state in the Secure Enclave that can't be removed.
omarchy-hw-apple-silicon || exit 0

status=$(cat /run/omarchy-mac/touchid 2>/dev/null)
recorded_status=${status:-no status}
# A Mac without a sensor records nothing at boot, and neither does a status
# service that failed, so the answer is worked out again.
if [[ -z $status ]]; then
  status=$(/usr/lib/omarchy-mac/touchid-eligibility 2>/dev/null)
fi
if [[ -e /etc/omarchy-mac/touchid-on ]]; then
  # A Mac turned on before the record came with driver options gets them now,
  # whatever its status: on a kernel that loads the driver read-only, the
  # options are what lets it reach ready after a restart.
  options=/etc/modprobe.d/omarchy-mac-touchid.conf
  # Options and login policy share the setup/removal lock, so a removal
  # running now can't be undone here.
  lock=/run/omarchy-mac/touchid.lock
  if ! { mkdir -p -m 0755 "${lock%/*}" && exec {lock_fd}>>"$lock"; } 2>/dev/null; then
    echo "Touch ID's driver options could not be written: its lock, $lock, could not be opened." >&2
    exit 1
  elif ! flock -w 300 "$lock_fd"; then
    echo "Touch ID's driver options could not be written: another Touch ID setup or removal is still running." >&2
    exit 1
  fi
  if [[ ! -e /etc/omarchy-mac/touchid-on ]]; then
    echo "Touch ID was turned off while this ran, so setup goes on without it."
    exit 0
  elif [[ ! -e $options ]]; then
    { mkdir -p -m 0755 "${options%/*}" &&
      printf '%s\n' "# The owner turned on Touch ID; omarchy-mac's disable-fingerprint removes this." \
        "options apple_sep xart_writes=1 provision_keybag=1" >"$options.new" &&
      chmod 0644 "$options.new" && mv -fT "$options.new" "$options"; } ||
      { rm -f "$options.new" 2>/dev/null; echo "Touch ID's driver options could not be written to $options" >&2; exit 1; }
  fi
  # The owner agreed already, so they are never asked again: a Touch ID that
  # isn't ready yet needs a restart, and setup goes on with any other reader.
  if [[ $status != "ready" ]]; then
    echo "Touch ID is turned on but isn't ready yet ($recorded_status)."
    echo "Restart this Mac, then set up the fingerprint again. If it still isn't"
    echo "ready, see journalctl -u omarchy-mac-touchid-activate."
  elif [[ -e /etc/omarchy-mac/touchid-sddm ]] && ! /usr/lib/omarchy-mac/touchid-sddm enable; then
    # Only an owner who was told about the login screen gets it, and it never stops setup.
    echo "Touch ID's SDDM login was left as it is: its PAM configuration is not one this package manages." >&2
  fi
  exec {lock_fd}>&-
  exit 0
fi
# Only a Touch ID that can be set up stops the setup: anywhere else it goes on,
# so a USB reader enrols as it would without Touch ID.
case $status in
  available | ready) ;;
  none | "")
    exit 0
    ;;
  *)
    echo "Touch ID can't be used on this Mac yet ($status), so setup goes on with"
    echo "any other fingerprint reader."
    # A driver that came up wrong this boot stays so until a restart.
    case $status in
      failed | not-ready | unproven | blocked) echo "Restart this Mac, then set up the fingerprint again to retry Touch ID." ;;
    esac
    exit 0
    ;;
esac

neo=0
if tr '\0' '\n' </proc/device-tree/compatible | grep -Fxq apple,t8140; then
  neo=1
fi

echo "Touch ID on Linux uses this Mac's Secure Enclave."
echo
if [[ -e /var/lib/aurora-sep-keybag.bin ]]; then
  echo "Turning it on loads the Secure Enclave driver and uses the key store for"
  echo "Linux that an earlier Touch ID setup created on this Mac."
else
  echo "Turning it on loads the Secure Enclave driver and creates a key store for"
  echo "Linux on this Mac."
fi
echo "In normal use the enclave advances its anti-replay state, which only moves"
echo "forward. Linux and macOS share that state: it is one file in this Mac's"
echo "iBoot System Container, and both systems update it."
echo
echo "This is experimental, non-Apple support for the Secure Enclave. If a bug"
echo "in it ever writes that shared state wrongly, the enclave stops accepting"
echo "it, and macOS can lose data:"
echo "  - With FileVault on, macOS can't unlock its disk and won't start, and"
echo "    the startup picker may not open. Getting the Mac back takes a DFU"
echo "    restore, which erases it."
echo "  - With FileVault off, macOS resets its keychain and Touch ID"
echo "    fingerprints and shows a warning."
echo "Back up anything on macOS you still need before you turn it on."
echo
if (( neo )); then
  echo "On this Mac it also reads the sensor's key from the factory records the"
  echo "installer left on the boot partition, into a firmware file only root can"
  echo "read. Turning Touch ID off deletes that file."
  echo
fi
echo "Turning Touch ID off later removes your fingerprints and stops the driver"
echo "loading. The key store stays."
echo
echo "This applies to every user on this Mac and needs an administrator."
echo "On a stock SDDM login screen, fingerprints also work when you log in"
echo "again later in a boot: submit an empty password, then touch the sensor."
echo "A typed password always works, but an account with no password can no"
echo "longer log in there. A custom SDDM PAM configuration is kept."
echo "Saying no leaves Touch ID off. You can turn it on later from"
echo "Setup > Security > Fingerprint."
echo
read -r -p "Turn on Touch ID? [y/N] " answer || answer=""
if [[ $answer == [yY] || $answer == [yY][eE][sS] ]]; then
  exec /usr/lib/omarchy-mac/touchid-enable
else
  echo "Touch ID stays off."
  exit 1
fi
