#!/bin/bash
# omarchy-lifecycle-dispatch disable-fingerprint: Omarchy's fingerprint removal
# runs this as root once the fingerprints are deleted. Removing the owner's
# agreement stops the driver loading, and writing, at boot; the key store stays.
# The sensor key a Neo or a 16-inch M4 Pro or M4 Max rebuilt goes too, with the
# M4s' calibration: turning Touch ID on again rebuilds them.
omarchy-hw-apple-silicon || exit 0

# Waits for a Touch ID setup still running, which could otherwise install its
# sensor key after this removes it.
lock=/run/omarchy-mac/touchid.lock
if ! { mkdir -p -m 0755 "${lock%/*}" && exec {lock_fd}>>"$lock"; } 2>/dev/null; then
  echo "Touch ID could not be turned off: its lock, $lock, could not be opened." >&2
  exit 1
elif ! flock -w 300 "$lock_fd"; then
  echo "Touch ID could not be turned off: another Touch ID setup is still running. Try again once it finishes." >&2
  exit 1
fi

# What Touch ID setup rebuilt from the factory records; the next setup rebuilds it.
rebuilt=(/usr/lib/firmware/updates/apple/msrk-j700.bin /usr/lib/firmware/updates/apple/msrk-j616s.bin
  /usr/lib/firmware/updates/apple/mesacal-j616s.bin /usr/lib/firmware/updates/apple/msrk-j616c.bin
  /usr/lib/firmware/updates/apple/mesacal-j616c.bin /usr/lib/firmware/updates/apple/msrk-j614c.bin
  /usr/lib/firmware/updates/apple/mesacal-j614c.bin)
records=(/etc/omarchy-mac/touchid-on /etc/modprobe.d/omarchy-mac-touchid.conf)
present=()
for file in "${records[@]}" "${rebuilt[@]}" "${rebuilt[@]/%/.new}"; do
  [[ -e $file ]] && present+=("$file")
done
if (( ${#present[@]} )); then
  # A record left behind, on a read-only root say, loads the driver again.
  if ! rm -f "${present[@]}"; then
    left=()
    for file in "${present[@]}"; do
      [[ -e $file ]] && left+=("$file")
    done
    echo "Touch ID could not be turned off: remove ${left[*]}" >&2
    exit 1
  fi
  echo "Touch ID stops loading at the next boot. The key store for Linux stays on this Mac."
fi
# Without the record this takes the re-arm out of sudo's and polkit's stacks.
/usr/lib/omarchy-mac/touchid-pam || exit 1
exit 0
