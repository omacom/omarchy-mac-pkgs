#!/usr/bin/python3
# omarchy:summary=Reconcile the Asahi microphone stereo mapping
# omarchy:group=audio
# omarchy:args=[--watch|--save-state]
# omarchy:hidden=true

import argparse
import array
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import select
import signal
import subprocess
import sys
import tempfile
import time
import uuid

# The mapping is a typed stereo source: pipewire-pulse's remap source, a
# loopback whose capture stream records asahi-audio's mono DSP microphone and
# whose other side is an Audio/Source with front-left and front-right, like a
# stock microphone. The desktop shell drives such a source's volume, mute and
# level meter as it does any other; it gives an Audio/Source/Virtual (the
# null sink 0.1.2 mapped into) no level meter, and its peak monitor drops
# every buffer of the mono DSP source. WirePlumber links the mono port to one
# side only, so the mapper links it to the other.
# Earlier still the mapping was a null sink whose monitor was the default
# input, but pipewire-pulse clients that name no device (most apps) were then
# linked to the default sink's monitor instead: silence (#99).
MAPPING = 'omarchy_asahi_mic'
CAPTURE = 'input.' + MAPPING
LEGACY = MAPPING + '.monitor'
VIRTUAL = 'media.class=Audio/Source/Virtual'
OWNER = 'omarchy.asahi-mic.owner'
ROUTE_CLIENT = 'omarchy-asahi-mic-route'
DSP = re.compile(r'effect_output\.j[0-9]+-mic')
# asahi-audio's mono DSP output: AUX0, or MONO since asahi-audio ab1b469.
DSP_PORTS = ('capture_AUX0', 'capture_MONO')
# The microphone array's ALSA card, present even when its DSP graph is not,
# and asahi-audio's WirePlumber rules, which name the cards it builds one for.
ARRAY = re.compile(r'\[(AppleJ[0-9]+(?:HPAI|AOP)) *\]')
ASOUND_CARDS = Path('/proc/asound/cards')
WIREPLUMBER_CONF = Path('/usr/share/wireplumber/wireplumber.conf.d')
# What the DSP graph is built from. An update that changes them (a plugin the
# graph lacked) brings no audio event: WirePlumber builds the graph only when
# the array's node appears, so the mapper restarts it.
AUDIO_FILES = (Path('/usr/lib/lv2'), Path('/usr/share/asahi-audio'), Path('/usr/share/wireplumber/wireplumber.conf.d'))
# A watcher with no record may be the first run after the update that brought
# the missing files: it looks once, this long after starting.
FIRST_LOOK = 30.0
MODEL = Path('/proc/device-tree/model')
OUTAGE_GRACE = 10.0
REPAIR_INTERVAL = 300.0
DEFERRED = 75
# Restarting audio stops and restarts the shell around it (a shell under a
# vanishing PipeWire crashes): the watchdog does that, a plain restart not.
# The click runs from the shell, so the repair runs as a unit of its own.
RESTART_AUDIO = ('systemd-run', '--user', '--quiet', '--collect', 'omarchy-audio-watchdog', '--repair', 'stack', '--manual')
outage = dict(since=None, notified=False, repaired=False)
# After WirePlumber is restarted the rebuilt graph may appear before the event
# subscription is listening, so the watcher looks again shortly anyway.
recheck = dict(at=None)
# Set once an update changed AUDIO_FILES and kept in the runtime record until
# a pass has acted on it, so a watcher that reloads mid-update keeps it.
installed = dict(pending=False, retry_at=None, record=None, signature=None)
# The mapping's Pulse index, so a change of its own gain or mute is saved.
mapping_index = dict(value=None)
# A package upgrade replaces this file under a running watcher, and pacman
# restarts no user service: the watcher runs the new file itself.
PACMAN_LOCK = Path('/var/lib/pacman/db.lck')
RELOAD = 'reload'


class Deferred(Exception):
    pass


class Audio:
    stamp = None

    def restart_session_manager(self, reason):
        # The audio watchdog owns every automatic audio restart: it kills the
        # wedged WirePlumber around a stopped shell, and declines (DEFERRED)
        # during a logout, under the lock screen or while another repair runs.
        # It runs as its own unit, so a mapper that stops or gives up waiting
        # never leaves the shell stopped. Returns its exit code.
        return subprocess.run(['systemd-run', '--user', '--wait', '--quiet', '--collect', '--unit=omarchy-audio-repair-%d' % os.getpid(),
                               '--description=Restart WirePlumber for the microphone mapping',
                               'omarchy-audio-watchdog', '--repair', 'wireplumber', '--reason', reason],
                              stdin=subprocess.DEVNULL, capture_output=True, timeout=300).returncode

    def run(self, *args):
        # Errors are matched in English (pw-link's EPERM below).
        try:
            return subprocess.run(args, check=True, capture_output=True, text=True, timeout=5,
                                  env=dict(os.environ, LC_ALL='C')).stdout.strip()
        except subprocess.CalledProcessError as error:
            raise RuntimeError(' '.join(args[:2]) + ': ' + error.stderr.strip()) from error

    def objects(self, kind):
        result = json.loads(self.run('pactl', '--format=json', 'list', kind))
        if not isinstance(result, list):
            raise ValueError('Invalid PulseAudio object list')
        return result

    def modules(self):
        # PipeWire's pactl JSON module rows omit the numeric index. The short
        # format retains the load-module identity needed for scoped rollback.
        # A multi-line module argument (module-rt from asahi-audio's PipeWire
        # config) continues on lines without an index; they are not modules.
        result = []
        for line in self.run('pactl', 'list', 'short', 'modules').splitlines():
            fields = line.split('\t')
            if len(fields) < 3 or not fields[0].isdecimal():
                continue
            result.append(dict(index=fields[0], name=fields[1], argument=fields[2]))
        return result

    def graph(self):
        result = json.loads(self.run('pw-dump'))
        if not isinstance(result, list):
            raise ValueError('Invalid PipeWire graph')
        return result

    def pause(self):
        time.sleep(0.1)

    def array(self):
        # An array card asahi-audio builds a DSP microphone for.
        try:
            cards = ARRAY.findall(ASOUND_CARDS.read_text())
            rules = ''.join(path.read_text(errors='replace') for path in sorted(WIREPLUMBER_CONF.glob('*.conf')))
        except OSError:
            return False
        return any('"hw:%s,' % card in rules for card in cards)

    def updating(self):
        return PACMAN_LOCK.exists() and pacman_running()

    def notify(self, headline, body, *command):
        try:
            subprocess.Popen(['omarchy-notification-send', '-g', '\U000f036d', '-u', 'normal', headline, body, '--exec', *command],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass

    def signal(self, source, timeout=3.0):
        # A linked monitor can still carry only digital silence (exact zeros);
        # a live microphone never does, even at low gain in float samples.
        # Samples are inspected, never kept. None: nothing could be read.
        try:
            process = subprocess.Popen(['parec', '--device=' + source, '--raw', '--format=float32le', '--channels=2',
                                        '--rate=48000', '--latency-msec=20', '--client-name=omarchy-asahi-mic-probe'],
                                       stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError:
            return None
        deadline = time.monotonic() + timeout
        pending = b''
        result = None
        try:
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not select.select([process.stdout], [], [], remaining)[0]:
                    return result
                chunk = os.read(process.stdout.fileno(), 4096)
                if not chunk:
                    return result
                pending += chunk
                whole = len(pending) - len(pending) % 4
                if whole:
                    if any(array.array('f', pending[:whole])):
                        return True
                    result = False
                    pending = pending[whole:]
        finally:
            process.kill()
            process.wait()
            process.stdout.close()


    def route(self, timeout=3.0):
        # Which nodes feed a capture that names no device, as most apps do.
        # None: the capture never started or was not linked in time.
        try:
            process = subprocess.Popen(['parec', '--raw', '--format=float32le', '--channels=2', '--rate=48000',
                                        '--latency-msec=20', '--client-name=' + ROUTE_CLIENT],
                                       stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError:
            return None
        try:
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                if select.select([process.stdout], [], [], 0.1)[0] and not os.read(process.stdout.fileno(), 65536):
                    return None
                feeds = sources_of(self.graph(), ROUTE_CLIENT)
                if feeds:
                    return feeds
            return None
        finally:
            process.kill()
            process.wait()
            process.stdout.close()


def sources_of(graph, client):
    nodes = {obj['id']: obj.get('info', {}).get('props', {}) for obj in graph if obj.get('type', '').endswith(':Node')}
    ports = {obj['id']: obj.get('info', {}).get('props', {}).get('node.id') for obj in graph if obj.get('type', '').endswith(':Port')}
    client_nodes = {id_ for id_, props in nodes.items() if client in (props.get('node.name'), props.get('application.name'))}
    feeds = set()
    for obj in graph:
        info = obj.get('info', {})
        if not obj.get('type', '').endswith(':Link') or info.get('state') == 'error':
            continue
        if info.get('input-node-id', ports.get(info.get('input-port-id'))) not in client_nodes:
            continue
        name = nodes.get(info.get('output-node-id', ports.get(info.get('output-port-id'))), {}).get('node.name')
        if name:
            feeds.add(name)
    return feeds


def port(graph, node_name, port_name):
    nodes = {obj['id'] for obj in graph if obj.get('type', '').endswith(':Node')
             and obj.get('info', {}).get('props', {}).get('node.name') == node_name}
    matches = [obj['id'] for obj in graph if obj.get('type', '').endswith(':Port')
               and obj.get('info', {}).get('props', {}).get('node.id') in nodes
               and obj['info']['props'].get('port.name') == port_name]
    if len(matches) != 1:
        return None
    return matches[0]


def dsp_port(graph, dsp):
    nodes = {obj['id'] for obj in graph if obj.get('type', '').endswith(':Node')
             and obj.get('info', {}).get('props', {}).get('node.name') == dsp}
    found = [obj['id'] for obj in graph if obj.get('type', '').endswith(':Port')
             and obj.get('info', {}).get('props', {}).get('node.id') in nodes
             and obj['info']['props'].get('port.name') in DSP_PORTS]
    return found[0] if len(found) == 1 else None


def capture_inputs(graph):
    # The mapping's capture side: front-left and front-right, or one MONO port
    # when PipeWire negotiated it down to a MONO DSP port and duplicates it.
    nodes = {obj['id'] for obj in graph if obj.get('type', '').endswith(':Node')
             and obj.get('info', {}).get('props', {}).get('node.name') == CAPTURE}
    found = {}
    for obj in graph:
        props = obj.get('info', {}).get('props', {})
        if obj.get('type', '').endswith(':Port') and props.get('node.id') in nodes and props.get('port.name') in ('input_FL', 'input_FR', 'input_MONO'):
            found.setdefault(props['port.name'], []).append(obj['id'])
    shape = sorted((name, len(ids)) for name, ids in found.items())
    if shape == [('input_FL', 1), ('input_FR', 1)]:
        return [found['input_FL'][0], found['input_FR'][0]]
    if shape == [('input_MONO', 1)]:
        return found['input_MONO']
    return None


def links(graph, output, input_):
    return [obj for obj in graph if obj.get('type', '').endswith(':Link')
            and obj.get('info', {}).get('output-port-id') == output
            and obj['info'].get('input-port-id') == input_
            and obj['info'].get('state') in ('active', 'paused')]


def failed_links(graph, output, input_):
    return [obj['id'] for obj in graph if obj.get('type', '').endswith(':Link')
            and obj.get('info', {}).get('output-port-id') == output
            and obj['info'].get('input-port-id') == input_
            and obj['info'].get('state') == 'error']


def gain(obj):
    values = [channel['value'] for channel in obj['volume'].values()]
    if len(values) != 2 or any(type(value) is not int or not 0 <= value < 2**32 - 1 for value in values) or type(obj['mute']) is not bool:
        raise ValueError('Invalid stereo mapping gain state')
    return dict(volume=values, mute=obj['mute'])


def audible(obj):
    return not obj['mute'] and any(channel['value'] for channel in obj['volume'].values())


def record_installed(pending, signature=None, retry_at=None):
    installed.update(pending=pending, retry_at=retry_at if pending else None)
    if signature is not None:
        installed['signature'] = signature
    record = installed['record']
    if record is None:
        return
    with contextlib.suppress(OSError):
        record.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode='w', dir=record.parent, delete=False) as temporary:
            json.dump(dict(signature=installed['signature'], pending=pending, retry_at=installed['retry_at']), temporary)
        os.replace(temporary.name, record)


def save_state(audio, path):
    sources = {obj['name']: obj for obj in audio.objects('sources')}
    if MAPPING not in sources:
        mapping_index['value'] = None
        return
    mapping_index['value'] = str(sources[MAPPING].get('index'))
    write_state(path, gain(sources[MAPPING]))


def write_state(path, value):
    data = json.dumps(dict(source=value), sort_keys=True)
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.read_text() == data:
        return
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as temporary:
        temporary.write(data)
    os.replace(temporary.name, path)


def legacy_gain(sink, monitor):
    # The old mapping captured through two controls in series: carry over their
    # product per channel, and a mute on either side.
    return dict(volume=[min(a * b // 65536, 2**32 - 2) for a, b in zip(sink['volume'], monitor['volume'])],
                mute=sink['mute'] or monitor['mute'])


def validated(state):
    return gain(dict(volume={str(i): {'value': value} for i, value in enumerate(state['volume'])}, mute=state['mute']))


def restore_gain(audio, path):
    if not path.exists():
        return
    saved = json.loads(path.read_text())
    # Validate persisted values before using them as pactl arguments.
    state = validated(saved['source']) if 'source' in saved else legacy_gain(validated(saved['sink']), validated(saved['monitor']))
    audio.run('pactl', 'set-source-volume', MAPPING, *(str(value) for value in state['volume']))
    audio.run('pactl', 'set-source-mute', MAPPING, '1' if state['mute'] else '0')


def owned(module, kind='module-remap-source'):
    argument = module.get('argument', '')
    name = ('source_name=' if kind == 'module-remap-source' else 'sink_name=') + MAPPING + ' '
    return module.get('name') == kind and name in argument + ' ' and OWNER + '=' in argument


def virtual(module):
    return owned(module, 'module-null-sink') and VIRTUAL in module.get('argument', '')


def retire_legacy(audio, state, dsp):
    # An earlier version mapped into a null sink. Keep its gain and mute, then
    # remove it: its sink could become the default output and its monitor fails
    # untargeted captures. A selected one hands the default to the DSP, which
    # the new mapping then takes over like any first mapping.
    sinks = {obj['name']: obj for obj in audio.objects('sinks')}
    if MAPPING not in sinks:
        return
    modules = [module for module in audio.modules() if owned(module, 'module-null-sink') and not virtual(module)]
    if len(modules) != 1:
        raise RuntimeError(MAPPING + ' is a sink this service does not own; not replacing it')
    sources = {obj['name']: obj for obj in audio.objects('sources')}
    if LEGACY in sources:
        write_state(state, legacy_gain(gain(sinks[MAPPING]), gain(sources[LEGACY])))
    selected = audio.run('pactl', 'get-default-source') == LEGACY
    audio.run('pactl', 'unload-module', modules[0]['index'])
    if selected:
        audio.run('pactl', 'set-default-source', dsp)


def retire_virtual(audio, state, dsp):
    # 0.1.2 mapped into a virtual source of the same name, which the shell
    # leaves without a level meter. Keep its gain and mute, then remove it; a
    # selected one hands the default to the DSP, which the typed mapping then
    # takes over like any first mapping, under the same name. Until then the
    # DSP is the default, as at every login before the mapping is selected;
    # a saved mute is restored on the typed source before it is selected.
    # Only a mapper restarted within a session meets a 0.1.2 source: a new
    # session's pipewire-pulse starts without modules.
    modules = [module for module in audio.modules() if virtual(module)]
    if not modules:
        return
    sources = {obj['name']: obj for obj in audio.objects('sources')}
    if MAPPING in sources:
        write_state(state, gain(sources[MAPPING]))
    selected = audio.run('pactl', 'get-default-source') == MAPPING
    for module in modules:
        audio.run('pactl', 'unload-module', module['index'])
    if selected:
        audio.run('pactl', 'set-default-source', dsp)


def session_priority(obj):
    raw = (obj.get('properties') or {}).get('priority.session', 0)
    try:
        return int(raw)
    except (TypeError, ValueError):
        return 0


def port_usable(device):
    ports = device.get('ports') or []
    active = device.get('active_port')
    return not any(port.get('name') == active and port.get('availability') == 'not available' for port in ports)


def real_inputs(sources):
    # A monitor only repeats a sink, asahi-audio's raw array (RawMics) is
    # uncalibrated, and the mapping carries only the array: none of them can
    # stand in for it. WirePlumber ignores a default whose port is unplugged.
    def monitor(source):
        return (source['name'].endswith('.monitor') or source.get('monitor_source')
                or (source.get('properties') or {}).get('device.class') == 'monitor')
    candidates = [source for source in sources if source.get('name') and not monitor(source)
                  and source['name'] != MAPPING and not source['name'].endswith('.RawMics') and port_usable(source)]
    candidates.sort(key=lambda source: (-session_priority(source), source['name']))
    return [source['name'] for source in candidates]


def fallback_path(state):
    return state.with_suffix('.fallback')


def claim(state):
    path = fallback_path(state)
    return path.read_text() if path.exists() else None


def mapping_audible(sources):
    return any(obj['name'] == MAPPING and audible(obj) for obj in sources)


def leave_mapping(audio, state, sources, original_input):
    # The array's DSP is gone (#99: WirePlumber left its filter half-built), so
    # the mapping carries silence and must not stay the default input.
    # WirePlumber would fall back to a monitor, so hand capture to a plugged-in
    # real input, and claim that choice so the mapping is selected again when
    # the array returns. Choosing another real input ends the claim; losing the
    # claimed one (unplugged) hands over again. A muted mapping is the user's
    # mute: never hand it to an unmuted microphone.
    claimed = claim(state)
    inputs = real_inputs(sources)
    if claimed and original_input != claimed and original_input in inputs:
        fallback_path(state).unlink()
        claimed = None
    if original_input == MAPPING:
        eligible = mapping_audible(sources)
    else:
        eligible = claimed is not None and original_input not in inputs
    if eligible and inputs and audio.run('pactl', 'get-default-source') == original_input:
        audio.run('pactl', 'set-default-source', inputs[0])
        if audio.run('pactl', 'get-default-source') == inputs[0]:
            path = fallback_path(state)
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(inputs[0])


def repair_graph(audio, reason, force=False):
    # WirePlumber 0.5 (wireplumber#1028) keeps the ids of a DSP graph it tore
    # down (a logout, a card profile change) in its hidden list and hides them
    # from every later client, so the rebuilt microphone graph stays hidden or
    # refuses the mapping's links until WirePlumber restarts. Ask the audio
    # watchdog to restart it, at most once every few minutes whatever keeps
    # failing; the watchdog adds its own budget and never restarts during a
    # logout. The stamp holds the boot-relative time of the last attempt,
    # shared by every mapper process.
    # Returns True (restarted), False, or DEFERRED: not now (a logout, the
    # lock screen, another repair), try again soon; that costs no attempt.
    if audio.stamp is not None and not force:
        try:
            if 0 <= time.monotonic() - float(audio.stamp.read_text()) < REPAIR_INTERVAL:
                return False
        except (OSError, ValueError):
            pass
    try:
        code = audio.restart_session_manager(reason)
    except (OSError, subprocess.SubprocessError) as error:
        print('Could not restart WirePlumber: ' + str(error), file=sys.stderr, flush=True)
        code = 1
    if code == DEFERRED:
        return DEFERRED
    if audio.stamp is not None:
        try:
            audio.stamp.parent.mkdir(parents=True, exist_ok=True)
            audio.stamp.write_text(repr(time.monotonic()))
        except OSError as error:
            print('Could not record the WirePlumber repair: ' + str(error), file=sys.stderr, flush=True)
    if code != 0:
        return False
    recheck['at'] = time.monotonic() + 3.0
    return True


def card_disabled(audio):
    # A built-in card the user switched off is no lost graph to repair.
    try:
        cards = audio.objects('cards')
    except Exception:
        return False
    return any(str(card.get('name', '')).startswith('alsa_card.platform-') and card.get('active_profile') == 'off'
               for card in cards)


def outage_due():
    # Seconds until a pending lost-array notice or post-repair look is due, for
    # the watcher's wait.
    due = []
    if outage['since'] is not None and not outage['notified']:
        due.append(outage['since'] + OUTAGE_GRACE)
    if recheck['at'] is not None:
        if recheck['at'] <= time.monotonic():
            recheck['at'] = None
        else:
            due.append(recheck['at'])
    if not due:
        return None
    return max(0.1, min(due) - time.monotonic())


def description():
    # The name apps show for the microphone, as macOS words it: the family, not
    # the board code asahi-audio puts in its own nodes.
    try:
        model = MODEL.read_bytes().decode(errors='replace')
    except OSError:
        model = ''
    return ('MacBook' if 'MacBook' in model else 'Built-in') + ' Microphone'


def find_dsp(sources):
    return next((obj['name'] for obj in sources if DSP.fullmatch(obj['name'])), None)


def reconcile(audio, state, save_only=False, checked=None):
    if save_only:
        save_state(audio, state)
        return
    sources = audio.objects('sources')
    dsp = find_dsp(sources)
    if dsp:
        retire_legacy(audio, state, dsp)
        retire_virtual(audio, state, dsp)
        sources = audio.objects('sources')
    original_input = audio.run('pactl', 'get-default-source')
    if not dsp:
        mapped = any(obj['name'] == MAPPING for obj in sources)
        if mapped or claim(state):
            leave_mapping(audio, state, sources, original_input)
        # An update's changed files restart WirePlumber once, past the repair
        # interval; until that is done the outage repair and notice wait.
        updated = None
        if installed['pending'] and (installed['retry_at'] is None or time.monotonic() >= installed['retry_at']):
            if audio.updating():
                record_installed(True, retry_at=time.monotonic() + 5.0)
            else:
                updated = audio.array() and not card_disabled(audio) and repair_graph(audio, 'audio files changed while the Asahi DSP microphone was missing', force=True)
                if updated == DEFERRED:
                    record_installed(True, retry_at=time.monotonic() + 30.0)
                else:
                    record_installed(False)
            if installed['pending']:
                recheck['at'] = installed['retry_at']
        if not mapped:
            outage.update(since=None, notified=False, repaired=False)
        elif updated is True:
            outage.update(since=time.monotonic(), notified=False, repaired=True)
        elif installed['pending']:
            outage['since'] = None
        else:
            # A card or audio restart rebuilds the array within seconds; only a
            # lasting loss is worth telling the user about, once.
            # WirePlumber is restarted once first: a graph it left hidden
            # (#1028) is the usual lasting loss.
            if outage['since'] is None:
                outage['since'] = time.monotonic()
            elif not outage['notified'] and time.monotonic() - outage['since'] >= OUTAGE_GRACE:
                repaired = not outage['repaired'] and not card_disabled(audio) and repair_graph(audio, 'the Asahi DSP microphone is missing')
                if repaired is True:
                    outage.update(since=time.monotonic(), repaired=True)
                elif repaired == DEFERRED:
                    # Ask again in half a minute (after an unlock, say).
                    outage['since'] = time.monotonic() - OUTAGE_GRACE + 30.0
                else:
                    outage['notified'] = True
                    audio.notify('Built-in microphone unavailable', 'Click to restart audio', *RESTART_AUDIO)
        raise Deferred('No Asahi DSP microphone is present; user service will retry if an array appears')
    outage.update(since=None, notified=False, repaired=False)
    if installed['pending']:
        record_installed(False)
    fallback = fallback_path(state)
    claimed = claim(state)
    # A muted fallback keeps its claim: the array never unmutes capture. The
    # unmute itself is not watched; the next device event (or the backstop)
    # restores the array, and the fallback is a working input meanwhile. A
    # claimed fallback that went away (default fell to a monitor) returns too.
    muted_claim = claimed == original_input and any(obj['name'] == original_input and obj.get('mute') is not False for obj in sources)
    returning = claimed is not None and not muted_claim and (claimed == original_input or original_input not in real_inputs(sources))
    owner = uuid.uuid4().hex
    module = None
    changed_input = False
    problem = None
    def restore_input():
        if original_input and audio.run('pactl', 'get-default-source') == MAPPING:
            if original_input in {obj['name'] for obj in audio.objects('sources')}:
                if audio.run('pactl', 'get-default-source') == MAPPING:
                    audio.run('pactl', 'set-default-source', original_input)
    try:
        if any(obj['name'] == MAPPING for obj in sources):
            if not any(owned(module) for module in audio.modules()):
                raise RuntimeError(MAPPING + ' is a source this service does not own; not mapping into it')
        else:
            module = audio.run('pactl', 'load-module', 'module-remap-source', 'source_name=' + MAPPING, 'master=' + dsp,
                               'channels=2', 'channel_map=front-left,front-right',
                               "source_properties='device.description=\"" + description() + "\" priority.session=1 " + OWNER + '=' + owner + "'")
            if not module.isdecimal():
                raise RuntimeError('PulseAudio did not return a module identity')
            # A new mapping may reuse the port IDs of one sampled before an
            # audio restart; it has not been sampled yet.
            if checked is not None:
                checked.clear()
            # Some policy managers auto-select a new source. Undo only that
            # owned temporary choice before waiting for its links.
            restore_input()
        for attempt in range(30):
            graph = audio.graph()
            output = dsp_port(graph, dsp)
            inputs = capture_inputs(graph)
            if output is not None and inputs is not None:
                break
            audio.pause()
        else:
            raise RuntimeError('The Asahi DSP microphone port and the mapping capture ports must be ready')
        if module is not None:
            restore_gain(audio, state)
        def validate_endpoints(graph):
            if dsp_port(graph, dsp) != output or capture_inputs(graph) != inputs:
                raise RuntimeError('Asahi microphone endpoints changed during mapping')
        # WirePlumber links the mono port to the left (or negotiated MONO)
        # side as the remap source's target: wait for that link rather than
        # race it, and link the right side, which WirePlumber never does.
        if module is not None:
            for attempt in range(20):
                if links(audio.graph(), output, inputs[0]):
                    break
                audio.pause()
        for input_ in reversed(inputs):
            graph = audio.graph()
            validate_endpoints(graph)
            if not links(graph, output, input_):
                link = ('pw-link', '-L', '-w', '-p', json.dumps({OWNER: owner}), str(output), str(input_))
                try:
                    audio.run(*link)
                except RuntimeError as error:
                    if 'File exists' not in str(error):
                        raise
                    # WirePlumber made the same link meanwhile, which is
                    # fine; one it left failed holds the ports and carries
                    # nothing, so it is replaced.
                    failed = failed_links(audio.graph(), output, input_)
                    if failed:
                        for id_ in failed:
                            audio.run('pw-link', '-d', str(id_))
                        audio.run(*link)
        for attempt in range(30):
            graph = audio.graph()
            validate_endpoints(graph)
            if all(links(graph, output, input_) for input_ in inputs):
                break
            audio.pause()
        else:
            raise RuntimeError('Asahi microphone stereo links did not become ready')
        current_input = audio.run('pactl', 'get-default-source')
        key = (output, *inputs)
        # A mapping the default route was seen to bypass is not selected again,
        # or the default would flip between it and the DSP on every event.
        misrouted = ('misroute',) + key in (checked or ())
        select_mapping = (original_input in ('', dsp) or returning) and current_input == original_input and not misrouted
        # Only a mapping that carries the microphone may be the default input: a
        # linked one can still carry digital silence (#505). A muted mapping is
        # the user's microphone mute (the mute key mutes the default source),
        # even one muted while it is sampled: it is never sampled or swapped
        # for the unmuted DSP, and stays selectable. A default mapping is
        # sampled once, not on every event.
        def audible_now():
            return mapping_audible(audio.objects('sources'))
        sampled = True
        if (select_mapping or (current_input == MAPPING and key not in (checked or ()))) and audible_now():
            sampled = audio.signal(MAPPING)
            if sampled is True and checked is not None:
                checked.add(key)
            elif sampled is not True and not audible_now():
                sampled = True
        graph = audio.graph()
        validate_endpoints(graph)
        if not all(links(graph, output, input_) for input_ in inputs):
            raise RuntimeError('Asahi microphone links changed before selecting input')
        # Read the user's choice after the final graph query so a device change
        # during that query is not overwritten. Pulse has no atomic compare/set.
        if audio.run('pactl', 'get-default-source') == current_input:
            if select_mapping and sampled:
                changed_input = True
                audio.run('pactl', 'set-default-source', MAPPING)
            elif current_input == MAPPING and sampled is False and audible_now():
                audio.run('pactl', 'set-default-source', dsp)
        # Keep the claim only while the fallback is still the default and the
        # returning mapping could not be confirmed live yet.
        if not muted_claim and not (select_mapping and returning and sampled is not True):
            fallback.unlink(missing_ok=True)
        if sampled is None:
            problem = 'Could not sample the Asahi microphone stereo mapping; the default input is unchanged'
        elif sampled is False:
            problem = 'Asahi microphone stereo mapping carries no signal; it is not the default input'
        elif changed_input or (current_input == MAPPING and ('route',) + key not in (checked or ())):
            # The explicit sample above cannot show where apps that name no
            # device are linked (#99). Check that route once per mapping.
            feeds = audio.route()
            if feeds is not None and checked is not None:
                checked.add(('route',) + key)
            if feeds is not None and feeds != {MAPPING} and audio.run('pactl', 'get-default-source') == MAPPING:
                if checked is not None:
                    checked.add(('misroute',) + key)
                audio.run('pactl', 'set-default-source', dsp)
                problem = 'Apps recording from the default input reach ' + ', '.join(sorted(map(str, feeds))) + ', not the Asahi microphone mapping; the default input is the DSP'
        # Existing DSP gain/mute is never reset. Save only the owned mapping so
        # a new module after a daemon restart can recover it.
        save_state(audio, state)
    except Exception:
        def cleanup(action):
            try:
                action()
            except Exception as error:
                print('Asahi microphone rollback incomplete: ' + str(error), file=sys.stderr)
        def restore_changed_input():
            if changed_input or module is not None:
                restore_input()
        def remove_links():
            for obj in audio.graph():
                if obj.get('type', '').endswith(':Link') and obj.get('info', {}).get('props', {}).get(OWNER) == owner:
                    audio.run('pw-link', '-d', str(obj['id']))
        def remove_module():
            if module is not None:
                for obj in audio.modules():
                    if str(obj['index']) == module and obj.get('name') == 'module-remap-source' and OWNER + '=' + owner in obj.get('argument', ''):
                        audio.run('pactl', 'unload-module', module)
        # A dead PipeWire graph must not prevent removing a module still owned
        # by PulseAudio, or restoring a default that this invocation changed.
        for action in (restore_changed_input, remove_links, remove_module):
            cleanup(action)
        error = sys.exc_info()[1]
        if isinstance(error, RuntimeError) and str(error).startswith('pw-link') and 'Operation not permitted' in str(error):
            repair_graph(audio, 'it refused the microphone mapping links')
        raise
    if problem:
        # The mapping stays so it is not rebuilt on every event; only the
        # default input avoids it.
        raise RuntimeError(problem)


@contextlib.contextmanager
def mapping_lock(runtime):
    with (runtime / 'omarchy-asahi-mic.lock').open('a') as lock:
        deadline = time.monotonic() + 15
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError('Another Asahi microphone repair is still running')
                time.sleep(0.1)
        yield


def run_once(audio, runtime, state, save_only=False, checked=None):
    if not os.environ.get('PULSE_SERVER') and not os.environ.get('PIPEWIRE_REMOTE') and not any((runtime / path).exists() for path in ('pulse/native', 'pipewire-0')):
        raise Deferred('No audio session endpoints; microphone mapping deferred to the user service')
    with mapping_lock(runtime):
        reconcile(audio, state, save_only, checked)


def pacman_running():
    for comm in Path('/proc').glob('[0-9]*/comm'):
        with contextlib.suppress(OSError):
            if comm.read_text().strip() == 'pacman':
                return True
    return False


class Program:
    # The watcher's own file is replaced once it differs from the one started,
    # is unchanged since the previous look and no pacman transaction (which may
    # upgrade the interpreter too) holds the database; a lock no pacman holds is stale.
    def __init__(self, path, lock=None, running=pacman_running):
        self.path = Path(path)
        self.lock = Path(PACMAN_LOCK if lock is None else lock)
        self.running = running
        self.started = self.seen = self.signature()
        self.retry_at = None
        self.backoff = 2.0

    def signature(self):
        try:
            status = os.stat(self.path)
        except OSError:
            return None
        return status.st_dev, status.st_ino, status.st_size, status.st_mtime_ns

    def replaced(self):
        current = self.signature()
        previous, self.seen = self.seen, current
        if current is None or current == self.started or current != previous:
            return False
        if self.retry_at is not None and time.monotonic() < self.retry_at:
            return False
        if self.lock.exists() and self.running():
            return False
        return os.access(self.path, os.X_OK)

    def run(self):
        # Returns only when the new file cannot be run (the interpreter may be
        # mid-replacement): the old code goes on and tries again, backing off.
        print('Running the updated microphone mapper', file=sys.stderr, flush=True)
        try:
            os.execv(self.path, [str(self.path), *sys.argv[1:]])
        except OSError as error:
            print('Could not run the updated microphone mapper: ' + str(error), file=sys.stderr, flush=True)
            self.retry_at = time.monotonic() + self.backoff
            self.backoff = min(self.backoff * 2, 300.0)


class Installed:
    # Wakes a pass once a finished update changed AUDIO_FILES (a directory or
    # one of its subdirectories). The record in the runtime directory keeps the
    # last signature and a pending repair across a reload of the watcher.
    def __init__(self, record, paths=None, lock=None, running=pacman_running):
        installed['record'] = Path(record)
        self.paths = tuple(Path(path) for path in (AUDIO_FILES if paths is None else paths))
        self.lock = Path(PACMAN_LOCK if lock is None else lock)
        self.running = running
        try:
            saved = json.loads(installed['record'].read_text())
            signature, pending, retry_at = saved['signature'], saved['pending'], saved.get('retry_at')
            if not isinstance(signature, str) or type(pending) is not bool or not (retry_at is None or type(retry_at) is float):
                raise ValueError('Invalid microphone update record')
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            signature, pending, retry_at = self.signature(), True, time.monotonic() + FIRST_LOOK
        if signature is None:
            signature = ''
        record_installed(pending, signature, retry_at)
        if pending and retry_at is not None:
            recheck['at'] = retry_at

    def signature(self):
        # None: a directory could not be read; the previous signature stands.
        stamps = []
        try:
            for path in self.paths:
                entries = [path]
                if path.is_dir():
                    entries += sorted(path.iterdir())
                for entry in entries:
                    with contextlib.suppress(FileNotFoundError):
                        status = os.stat(entry)
                        stamps.append('%s %d %d' % (entry, status.st_ino, status.st_mtime_ns))
        except OSError:
            return None
        return '\n'.join(stamps)

    def changed(self):
        current = self.signature()
        if current is None or current == installed['signature'] or (self.lock.exists() and self.running()):
            return False
        # A repair already deferred keeps its retry time.
        record_installed(True, current, installed['retry_at'] if installed['pending'] else None)
        return True


class Subscription:
    # Wakes the supervisor when the mapping may need repair: a sink, source,
    # card or module appeared or vanished, a card or module changed, or the
    # server did (pipewire-pulse restart, default device switch). Sink and
    # source 'change' events are deliberately not watched: every stream start
    # and stop emits them, and the mapping only depends on node existence,
    # links and defaults. Client and stream events are ignored outright. A
    # burst settles for a quiet interval so a hot-plug repairs once, a cap
    # keeps a steady stream from starving repair, and a slow backstop keeps
    # the eventually-consistent guarantee that polling every two seconds gave.
    # A change of the mapping's own source only saves its gain and mute: an
    # audio restart must not bring back an older, unmuted microphone.
    EVENT = re.compile(rb"^Event '(new|remove)' on (sink|source|card|module) #|^Event 'change' on (card|module|server) #")
    SOURCE_CHANGE = re.compile(rb"^Event 'change' on source #([0-9]+)$")

    def __init__(self, command=('pactl', 'subscribe'), quiet=0.5, settle=5.0, backstop=600.0, retry=2.0, stale=None, poll=2.0, changed=None):
        self.command = list(command)
        self.quiet, self.settle, self.backstop, self.retry = quiet, settle, backstop, retry
        # stale() is asked every poll seconds, across waits, whether to stop
        # for RELOAD. A pass a moment after subscribing covers a device that
        # appeared before pactl had registered the subscription.
        self.stale, self.poll = stale, poll
        # changed() is asked on the same schedule whether to run a full pass.
        self.changed = changed
        self.next_poll = None
        self.confirm = None
        self.process = None
        self.buffer = b''
        # Save-only wakes never reset the backstop, or a busy microphone
        # would starve it.
        self.last_full = time.monotonic()

    def start(self):
        try:
            self.process = subprocess.Popen(self.command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
        except OSError:
            self.process = None
        self.buffer = b''
        if self.process is not None:
            self.confirm = time.monotonic() + 1.0
        return self.process is not None

    def stop(self):
        process, self.process = self.process, None
        if process is None:
            return
        process.stdout.close()
        if process.poll() is None:
            process.terminate()
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()

    def lines(self):
        chunk = os.read(self.process.stdout.fileno(), 4096)
        if not chunk:
            return None
        self.buffer += chunk
        *complete, self.buffer = self.buffer.split(b'\n')
        return complete

    def full(self):
        self.last_full = time.monotonic()
        self.confirm = None
        return False

    def polled(self):
        # RELOAD, True (run a full pass) or False.
        if self.stale is None and self.changed is None:
            return False
        now = time.monotonic()
        if self.next_poll is None:
            self.next_poll = now + self.poll
        if now < self.next_poll:
            return False
        self.next_poll = now + self.poll
        if self.stale is not None and self.stale():
            return RELOAD
        return self.changed is not None and self.changed()

    def wait(self, limit=None):
        # True: only the mapping's gain or mute may have changed. RELOAD: the
        # watcher's program was replaced.
        # A full pass follows every subscription, so a device that appeared
        # while nothing listened (the DSP at login) is still mapped.
        polled = self.polled()
        if polled == RELOAD:
            return RELOAD
        if polled:
            return self.full()
        if self.process is None:
            if not self.start():
                time.sleep(self.retry)
            return self.full()
        started = time.monotonic()
        hard = self.last_full + self.backstop if limit is None else min(self.last_full + self.backstop, started + limit)
        if self.confirm is not None:
            hard = min(hard, self.confirm)
        due = None
        latest = None
        repair = False
        while True:
            polled = self.polled()
            if polled == RELOAD:
                return RELOAD
            if polled:
                return self.full()
            now = time.monotonic()
            deadline = hard if due is None else min(due, latest) if repair else min(due, latest, hard)
            wake = deadline if self.next_poll is None else min(deadline, self.next_poll)
            if wake <= now or not select.select([self.process.stdout], [], [], wake - now)[0]:
                if time.monotonic() < deadline:
                    continue
                if due is None or repair or time.monotonic() >= hard:
                    return self.full()
                return True
            lines = self.lines()
            if lines is None:
                # The subscription ended: pipewire-pulse went away or is not up
                # yet. Repair now, then resubscribe after a pause.
                self.stop()
                time.sleep(self.retry)
                return self.full()
            woken = False
            for line in lines:
                if self.EVENT.match(line):
                    woken = repair = True
                else:
                    change = self.SOURCE_CHANGE.match(line)
                    if change and mapping_index['value'] is not None and change.group(1).decode() == mapping_index['value']:
                        woken = True
            if woken:
                now = time.monotonic()
                due = now + self.quiet
                if latest is None:
                    latest = now + self.settle


def supervise(operation, wait=None, program=None, changed=None):
    subscription = None
    if wait is None:
        subscription = Subscription(stale=None if program is None else program.replaced, changed=changed)
        subscription.start()
        wait = lambda: subscription.wait(outage_due())
    previous_error = None
    save_only = False
    try:
        while True:
            try:
                if save_only:
                    operation(save=True)
                else:
                    operation()
                previous_error = None
            except Exception as error:
                message = str(error)
                if message != previous_error:
                    print(message, file=sys.stderr, flush=True)
                    previous_error = message
            result = wait()
            if result == RELOAD:
                if subscription is not None:
                    subscription.stop()
                program.run()
                save_only = False
            else:
                save_only = bool(result)
    finally:
        if subscription is not None:
            subscription.stop()


def main():
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--watch', action='store_true')
    mode.add_argument('--save-state', action='store_true')
    args = parser.parse_args()
    if subprocess.run(['omarchy-hw-apple-silicon']).returncode:
        return 0
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/' + str(os.getuid())))
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'omarchy/asahi-mic-gain.json'
    checked = set()
    Audio.stamp = runtime / 'omarchy-asahi-mic.repaired'
    operation = lambda save=False: run_once(Audio(), runtime, state, args.save_state or save, checked)
    if args.watch:
        # Let a service stop unwind through supervise so the subscriber exits too.
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        supervise(operation, program=Program(os.path.abspath(sys.argv[0])),
                  changed=Installed(runtime / 'omarchy-asahi-mic.installed').changed)
    else:
        try:
            operation()
        except Deferred as error:
            print(error, file=sys.stderr)
            return 75
        except Exception as error:
            print('Asahi microphone mapping failed: ' + str(error), file=sys.stderr)
            return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
