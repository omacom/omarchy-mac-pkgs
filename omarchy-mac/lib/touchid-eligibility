#!/bin/bash
# Says, without loading the Secure Enclave driver, whether Touch ID can be set
# up here: "none" (no sensor), "available", or "unsupported:<reason>". With
# "sensor" it prints the sensor's device-tree node instead, and with "keybag"
# what the key store record says (below).

tree=${OMARCHY_MAC_TOUCHID_TREE:-/proc/device-tree}
firmware=${OMARCHY_MAC_TOUCHID_FIRMWARE:-/usr/lib/firmware}
extractors=${OMARCHY_MAC_TOUCHID_EXTRACTORS:-/usr/lib/linux-aurora}
python=${OMARCHY_MAC_TOUCHID_PYTHON:-python3}
esp=${OMARCHY_MAC_TOUCHID_ESP:-/boot/efi}
keybag=${OMARCHY_MAC_TOUCHID_KEYBAG:-/var/lib/aurora-sep-keybag.bin}
omarchy-hw-apple-silicon || exit 0

compatible() {
  [[ -r $tree/compatible ]] && tr '\0' '\n' <"$tree/compatible" | grep -Fxq "$1"
}

installed() {
  local directory
  for directory in "$firmware" "$firmware/vendor" "$firmware/updates"; do
    if [[ -f $directory/$1 ]]; then
      return 0
    fi
  done
  return 1
}

# The extractors are Python, which linux-aurora only suggests.
can_extract() {
  [[ -x $extractors/$1 ]] && command -v "$python" >/dev/null
}

# The driver writes the record (magic, version 2, state 0) before it asks the
# enclave to create the key store, and completes it once the enclave answers.
# "unfinished" while it stands: the driver then refuses to create another
# (EEXIST), since the enclave may hold one it never named, and nothing here
# removes it. "refused" (state 2): the enclave refused the creation, so none
# exists and the driver tries again. "present" for anything else there.
keybag_record() {
  local head
  [[ -e $keybag ]] || return 0
  head=$(od -An -v -t x1 -N 24 "$keybag" 2>/dev/null | tr -d ' \n')
  if [[ ${head:0:40} != 4150504c452d5345502d4b424147303102000000 ]]; then
    echo present
  elif [[ ${head:40} == 00000000 ]]; then
    echo unfinished
  elif [[ ${head:40} == 02000000 ]]; then
    echo refused
  else
    echo present
  fi
}
if [[ ${1:-} == "keybag" ]]; then
  keybag_record
  exit 0
fi

sensor=""
for node in "$tree"/soc/*/fingerprint@*; do
  if [[ -r $node/compatible ]] && tr '\0' '\n' <"$node/compatible" | grep -Fxq apple,mesa-fingerprint &&
    [[ ! -r $node/status || $(tr -d '\0' <"$node/status") == "okay" ]]; then
    sensor=$node
    break
  fi
done
if [[ ${1:-} == "sensor" ]]; then
  printf '%s\n' "$sensor"
  exit 0
elif [[ -z $sensor ]]; then
  echo none
  exit 0
fi

# The boards the aurora driver has a profile for. M1-family Macs cold-boot
# their enclave behind an xART guard that blocks matching, so they wait.
if compatible apple,t8103 || compatible apple,t6000 || compatible apple,t6001; then
  echo unsupported:m1-family
  exit 0
elif ! compatible apple,t8112 && ! compatible apple,t6020 && ! compatible apple,t6021 && ! compatible apple,t8140 &&
  ! { compatible apple,t8122 && { compatible apple,j613 || compatible apple,j615; }; }; then
  echo unsupported:board
  exit 0
fi

# m1n1's forwarded identity selects this install's own lane in the enclave.
if [[ ! -r $tree/chosen/apfs-preboot-uuid ]]; then
  echo unsupported:no-os-identity
  exit 0
fi

# The Neo's calibration must be the sealed form its installer writes; the
# other boards' can be carved from the iBoot System Container at enable time.
calibration=apple/mesa_calibration.bin
if [[ -r $sensor/firmware-name ]]; then
  calibration=$(tr -d '\0' <"$sensor/firmware-name")
fi
if ! installed "$calibration" && { compatible apple,t8140 || ! can_extract extract-mesa-calibration; }; then
  echo unsupported:no-calibration
  exit 0
fi
# The Neo's sensor key is rebuilt once the owner agrees, by touchid-root-key
# (Python), from the factory records asahi-installer leaves on the ESP.
if compatible apple,t8140 && ! installed apple/msrk-j700.bin &&
  { [[ ! -r $esp/asahi/all_firmware.tar.gz ]] || ! command -v "$python" >/dev/null; }; then
  echo unsupported:no-root-key
  exit 0
fi
if [[ $(keybag_record) == "unfinished" ]]; then
  echo unsupported:unfinished-keybag
  exit 0
fi
echo available
