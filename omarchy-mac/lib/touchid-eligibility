#!/bin/bash
# Says, without loading the Secure Enclave driver, whether Touch ID can be set
# up here: "none" (no sensor), "available", or "unsupported:<reason>". With
# "sensor" it prints the sensor's device-tree node instead.

tree=${OMARCHY_MAC_TOUCHID_TREE:-/proc/device-tree}
firmware=${OMARCHY_MAC_TOUCHID_FIRMWARE:-/usr/lib/firmware}
helpers=${OMARCHY_MAC_TOUCHID_HELPERS:-/usr/lib/omarchy-mac}
extractors=${OMARCHY_MAC_TOUCHID_EXTRACTORS:-/usr/lib/linux-aurora}
python=${OMARCHY_MAC_TOUCHID_PYTHON:-python3}
esp=${OMARCHY_MAC_TOUCHID_ESP:-/boot/efi}
omarchy-hw-apple-silicon || exit 0

source "$helpers/touchid-board.sh" || exit 1

installed() {
  local directory
  for directory in "$firmware" "$firmware/vendor" "$firmware/updates"; do
    if [[ -f $directory/$1 ]]; then
      return 0
    fi
  done
  return 1
}

# The extractors are Python, which linux-aurora only suggests.
can_extract() {
  [[ -x $extractors/$1 ]] && command -v "$python" >/dev/null
}

# The sensor sits on an SPI controller under /soc, or at the root on the M4 Pro
# and M4 Max.
sensor=$(touchid_sensor)
if [[ ${1:-} == "sensor" ]]; then
  printf '%s\n' "$sensor"
  exit 0
elif [[ -z $sensor ]]; then
  echo none
  exit 0
fi

# These cold-boot Macs need a kernel that can pin setup records under the guard.
if guarded_m1; then
  "$helpers/touchid-kernel-ready" 2>/dev/null
  case $? in
    0) ;;
    2) echo unsupported:restart; exit 0 ;;
    *) echo unsupported:kernel; exit 0 ;;
  esac
  if [[ ! -d ${OMARCHY_MAC_TOUCHID_MODULE:-/sys/module/apple_sep} ]] &&
    ! "$helpers/touchid-retry-aside" --check 2>/dev/null; then
    echo unsupported:recovery
    exit 0
  fi
elif m1_family; then
  echo unsupported:m1-family
  exit 0
elif ! other_touchid_board; then
  echo unsupported:board
  exit 0
fi

# m1n1's forwarded identity selects this install's own lane in the enclave.
if [[ ! -r $tree/chosen/apfs-preboot-uuid ]]; then
  echo unsupported:no-os-identity
  exit 0
fi

# The node's firmware-name lists the calibration, then, where the board names
# it, the sensor root key.
calibration=apple/mesa_calibration.bin
root_key=apple/msrk-j700.bin
if [[ -r $sensor/firmware-name ]]; then
  mapfile -t names < <(tr '\0' '\n' <"$sensor/firmware-name")
  calibration=${names[0]:-$calibration}
  root_key=${names[1]:-$root_key}
fi
# touchid-root-key (Python) rebuilds sealed factory data once the owner agrees,
# from the factory records asahi-installer leaves on the ESP.
can_reseal() {
  [[ -r $esp/asahi/all_firmware.tar.gz ]] && command -v "$python" >/dev/null
}
# The Neo's calibration must be the sealed form its installer writes, and the
# 16-inch M4 Pro's and M4 Max's is rebuilt from their factory records like
# their root key; the other boards' can be carved from the iBoot System
# Container at enable time.
if sealed_board; then
  if ! installed "$calibration" && ! can_reseal; then
    echo unsupported:no-calibration
    exit 0
  fi
elif ! installed "$calibration" && { compatible apple,t8140 || ! can_extract extract-mesa-calibration; }; then
  echo unsupported:no-calibration
  exit 0
fi
# The Neo's and the 16-inch M4 Pro's and M4 Max's sensor root key is rebuilt
# the same way.
if { compatible apple,t8140 || sealed_board; } && ! installed "$root_key" && ! can_reseal; then
  echo unsupported:no-root-key
  exit 0
fi
echo available
