#!/bin/bash
# Let Apple's native display replace simpledrm before the greeter opens its VT.
# Keep the existing 10 s wait on other Macs; opted-in J514C also needs its GPU.
# A timeout never fails the greeter.
omarchy-hw-apple-silicon || exit 0
proc=/proc
dev=/dev
sys=/sys
if (( EUID != 0 )); then
  proc=${OMARCHY_PROC_ROOT:-/proc}
  dev=${OMARCHY_DEV_ROOT:-/dev}
  sys=${OMARCHY_SYS_ROOT:-/sys}
fi
native_ready() {
  local path driver
  native_display=false
  native_gpu=false
  for path in "$sys"/class/drm/*; do
    [[ ${path##*/} =~ ^(card[0-9]+|renderD[0-9]+)$ ]] || continue
    driver=$(readlink -f "$path/device/driver") || continue
    if [[ ${path##*/} == card* && ${driver##*/} == "apple-drm" ]]; then
      native_display=true
    elif [[ ${path##*/} == renderD* && ${driver##*/} == "asahi-g15" && -e $dev/dri/${path##*/} ]]; then
      native_gpu=true
    fi
  done
  [[ $native_display == "true" && $native_gpu == "true" ]]
}

bringup=0
if [[ -r $proc/cmdline ]]; then
  read -r -a parameters <"$proc/cmdline"
  for parameter in "${parameters[@]}"; do
    [[ $parameter == asahi.g15_j514c_bringup=* ]] && bringup=${parameter#*=}
  done
fi
if [[ $bringup == "1" ]] &&
  grep -zqx 'apple,j514c' "$proc/device-tree/compatible" 2>/dev/null &&
  grep -zqx 'apple,t6031' "$proc/device-tree/compatible" 2>/dev/null; then
  started=$SECONDS
  deadline=$((SECONDS + 30))
  while (( SECONDS < deadline )); do
    if native_ready; then
      udevadm settle --timeout=10 || true
      native_ready && break
    fi
    sleep 0.05
  done
  printf 'J514C graphics readiness: native_display=%s native_gpu=%s wait_seconds=%s\n' \
    "$native_display" "$native_gpu" "$((SECONDS - started))"
else
  # Connectors are no test: simpledrm has one, and so does the GPU's own card.
  if [[ -e $proc/device-tree/soc/display-subsystem ]]; then
    for _ in {1..200}; do
      [[ -e $dev/dri/by-path/platform-soc:display-subsystem-card ]] && break
      sleep 0.05
    done
  fi
fi
exit 0
