#!/bin/bash
# Boots the Secure Enclave read-only for the microphone, passing each write option as 0
# unless the owner already set it: a second setting fails the load with EEXIST.
# It never enables a write; omarchy-mac-sep-load.service runs it.

omarchy-hw-apple-silicon || exit 1

sysfs=${OMARCHY_MAC_SEP_SYSFS:-/sys/module}

if [[ -d $sysfs/apple_sep ]]; then
  echo 'apple_sep is already loaded; its options stay as it loaded with'
else
  # Every setting of the two write options from modprobe's configuration, which
  # kmod fills with the apple_sep words of the kernel command line after the files.
  # The kernel reads the words its own way: any that is not a plain name=value is unread here.
  plain='^([A-Za-z0-9_-]+)=("[^"[:space:]]*"|[^"[:space:]]*)$'
  settings=""
  unreadable=""
  if ! configuration=$(modprobe -c); then
    unreadable="modprobe -c failed, so the options set for apple_sep are unknown"
  else
    while read -r keyword module options; do
      if [[ $keyword == options && ${module//-/_} == apple_sep ]]; then
        read -ra words <<<"$options"
        for word in "${words[@]}"; do
          if [[ ! $word =~ $plain ]]; then
            unreadable="apple_sep option '$word' is not a plain name=value, which the kernel may read differently"
          elif [[ ${BASH_REMATCH[1]//-/_} == @(xart_writes|provision_keybag) ]]; then
            settings+="${BASH_REMATCH[1]//-/_} ${BASH_REMATCH[2]//\"/}"$'\n'
          fi
        done
      fi
    done <<<"$configuration"
  fi

  # A write enabled elsewhere leaves the load to its owner; an option set twice
  # would fail it. The first of either, in option order, settles the outcome.
  arguments=()
  elsewhere=""
  repeated=""
  for option in xart_writes provision_keybag; do
    count=0
    while read -r name value; do
      if [[ $name == $option && $value != 0 ]]; then
        elsewhere="$option=$value"
        break
      elif [[ $name == $option ]]; then
        count=$((count + 1))
      fi
    done <<<"$settings"
    if [[ -n $elsewhere ]]; then
      break
    elif (( count > 1 )); then
      repeated="$option is set $count times"
      break
    elif (( count == 0 )); then
      arguments+=("$option=0")
    fi
  done

  if [[ -n $unreadable ]]; then
    echo "$unreadable, so the driver is not loaded here and the built-in microphones stay silent" >&2
    exit 1
  elif [[ -n $elsewhere ]]; then
    echo "apple_sep $elsewhere is set elsewhere: its owner loads the driver, and until it does the built-in microphones stay silent" >&2
  elif [[ -n $repeated ]]; then
    echo "apple_sep $repeated, and a second setting makes the load fail with EEXIST: set it once; until then the built-in microphones stay silent" >&2
    exit 1
  else
    exec modprobe -b apple-sep "${arguments[@]}"
  fi
fi
