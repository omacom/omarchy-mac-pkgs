#!/bin/bash
# Boots the Secure Enclave read-only for the microphone, passing each write option as 0
# unless the owner already set it: a second setting fails the load with EEXIST.
# It never enables a write; omarchy-mac-sep-load.service runs it.

omarchy-hw-apple-silicon || exit 1

sysfs=${OMARCHY_MAC_SEP_SYSFS:-/sys/module}

if [[ -d $sysfs/apple_sep ]]; then
  echo 'apple_sep is already loaded; its options stay as it loaded with'
  exit 0
fi

# Every setting of the two write options from modprobe's configuration, which
# kmod fills with the apple_sep words of the kernel command line after the files.
settings=$(modprobe -c | while read -r keyword module options; do
  if [[ $keyword == options && ${module//-/_} == apple_sep ]]; then
    for word in $options; do
      name=${word%%=*}
      value=${word#*=}
      printf '%s %s\n' "${name//-/_}" "${value//\"/}"
    done
  fi
done | grep -E '^(xart_writes|provision_keybag) ' || true)

arguments=()
for option in xart_writes provision_keybag; do
  count=0
  while read -r name value; do
    if [[ $name == $option ]]; then
      if [[ $value != 0 ]]; then
        echo "apple_sep $option=$value is set elsewhere: its owner loads the driver, and until it does the built-in microphones stay silent" >&2
        exit 0
      fi
      count=$((count + 1))
    fi
  done <<<"$settings"
  if (( count > 1 )); then
    echo "apple_sep $option is set $count times, and a second setting makes the load fail with EEXIST: set it once; until then the built-in microphones stay silent" >&2
    exit 1
  elif (( count == 0 )); then
    arguments+=("$option=0")
  fi
done

exec modprobe apple-sep "${arguments[@]}"
