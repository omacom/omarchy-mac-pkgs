#!/bin/bash
# Keeps pam_aurora_touchid (aurora-touchid-rearm) after `auth include system-auth`
# in sudo's and polkit's stacks while the owner has Touch ID on, and takes it
# out otherwise: a password there then ends a Touch ID lockout.

set -uo pipefail

agreed=${OMARCHY_MAC_TOUCHID_AGREED:-/etc/omarchy-mac/touchid-on}
pamd=${OMARCHY_MAC_PAMD:-/etc/pam.d}
lock=${OMARCHY_MAC_TOUCHID_PAM_LOCK:-/run/omarchy-mac/touchid-pam.lock}
marker='# omarchy-mac: a password here re-arms Touch ID; turning Touch ID off removes this'
module='-auth      optional                    pam_aurora_touchid.so'
include='^auth[[:space:]]+include[[:space:]]+system-auth[[:space:]]*$'
omarchy-hw-apple-silicon || exit 0

if ! { mkdir -p -m 0755 "${lock%/*}" && exec {lock_fd}>>"$lock" && flock -w 30 "$lock_fd"; } 2>/dev/null; then
  echo "Touch ID's PAM lines were not updated: $lock could not be locked." >&2
  exit 1
fi

# Writes a stack's new text beside it with the same owner and mode, then moves it into place.
replace() {
  local file=$1 text=$2 new
  new=$(mktemp "$file.XXXXXX") || return 1
  if printf '%s\n' "$text" >"$new" && chown --reference="$file" "$new" && chmod --reference="$file" "$new" && mv -fT "$new" "$file"; then
    return 0
  fi
  rm -f "$new"
  return 1
}

status=0
for service in sudo polkit-1; do
  file=$pamd/$service
  [[ -f $file && ! -L $file ]] || continue
  if grep -Fxq -- "$module" "$file"; then
    present=1
  else
    present=0
  fi
  if [[ -e $agreed ]]; then
    (( present )) && continue
    includes=$(grep -Ec "$include" "$file")
    if (( includes != 1 )); then
      echo "Touch ID's re-arm was not added to $file: it needs exactly one 'auth include system-auth' line." >&2
      continue
    fi
    text=$(awk -v marker="$marker" -v module="$module" -v pattern="$include" '{ print } $0 ~ pattern { print marker; print module }' "$file") || text=""
  else
    (( present )) || continue
    text=$(awk -v marker="$marker" -v module="$module" '$0 != marker && $0 != module' "$file") || text=""
  fi
  # Never writes a stack that lost its system-auth include: sudo would then refuse everyone.
  if ! grep -Eq "$include" <<<"$text" || ! replace "$file" "$text"; then
    echo "Touch ID's re-arm line could not be updated in $file." >&2
    status=1
  fi
done
exit "$status"
