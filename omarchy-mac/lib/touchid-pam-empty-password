#!/bin/bash
# pam_exec expose_authtok helper: succeed only when the greeter sent an empty
# password, which is how it asks for Touch ID. Reads all input so pam_exec never
# writes to a closed pipe; the password is never stored or printed.
password=
IFS= read -r -d '' password || true
if omarchy-hw-apple-silicon && [[ -z $password ]]; then
  exit 0
else
  exit 1
fi
